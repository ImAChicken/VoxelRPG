# Iron axe: a 24-inch haft and a bearded head
# Held model (character/HeldModelFile.h). Voxels in the item's own frame:
#   u (along)  out of the fist toward the business end
#   v (edge)   the way the edge faces
#   w (across) the flat side
# The fist holds it at u = v = w = 0. A voxel 'v i j k c' sits at origin + (i+0.5, j+0.5, k+0.5) * voxel,
# coloured by palette entry c. Named points (u v w) are traced through the world (edge*) or used for effects.
vxm 1
voxel 0.5
origin -3 -2.1 -1.3
along 0 -0.5 1
edge 0 -1 -0.5
across 1 0 0
color 1 138 92 56
color 2 78 54 40
color 3 118 122 130
color 4 214 220 226
point edge0 16.26 5.2 0
point edge1 18.5 5.5 0
point edge2 20.74 5.2 0
v 41 1 1 3
