# CMake build output — regenerate with: cmake -B build
build/

# Worlds you play; created by the game
saves/
# Dev worlds: share one on purpose with  git add -f devworlds/<name>
devworlds/*/
!devworlds/README.md

# A client's copies of servers' world settings and bakes
servercache/
# Packaged downloads (package.bat / tools/package.cmake)
/dist/
# The server's settings on this machine
/server.toml
# Logs (logs/) are pushed on purpose so agents can read them (src/app/Log.h);
# crash dumps are binary and large: kept on the machine only
logs/*.dmp

# F2 screenshots (src/app/Screenshot.h): big PNGs, kept on the machine
screenshots/
__pycache__/
